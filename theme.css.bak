/* Theme: Dark Purple/Blue Gradient with Glassmorphism
   Usage: add <link rel="stylesheet" href="theme.css"> in your page head to enable
*/
:root{
  --bg-1: #06121a;
  --bg-2: #0b1a2b;
  --accent-start: #D4AF37; /* premium gold */
  --accent-end: #B8860B;   /* darker gold */
  --muted: rgba(245,243,236,0.88);
  --glass: rgba(255,255,255,0.03);
  --glass-border: rgba(255,255,255,0.04);
  --glass-strong: rgba(255,255,255,0.06);
}

/* Page background: subtle dotted/star field + gradients */
html,body{height:100%;}
body.theme-dark{
  color: #f5f3ec;
  background:
    radial-gradient(1200px 600px at 10% 10%, rgba(212,175,55,0.10), transparent 10%),
    radial-gradient(1000px 500px at 90% 90%, rgba(212,175,55,0.06), transparent 10%),
    linear-gradient(180deg,var(--bg-1) 0%,var(--bg-2) 100%);
  font-family: Inter, 'Segoe UI', system-ui, -apple-system, 'Helvetica Neue', Arial;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

/* Navbar: translucent dark bar with subtle border */
.navbar{
  background: rgba(8,12,24,0.45);
  border-bottom: 1px solid rgba(255,255,255,0.03);
  backdrop-filter: blur(6px) saturate(120%);
}
.navbar .logo{
  display:inline-flex;align-items:center;gap:.6rem;color:var(--accent-start);font-weight:700;
}
.nav-links a{color:var(--muted);opacity:.9}
.nav-links a:hover{color:var(--accent-end)}
.nav-links a.active{position:relative;color:#fff}
.nav-links a.active:after{content:'';position:absolute;left:0;right:0;height:3px;border-radius:6px;background:linear-gradient(90deg,var(--accent-start),var(--accent-end));bottom:-12px}

/* Hero */
.hero{padding:6rem 0;position:relative}
.hero .badge{display:inline-block;background:linear-gradient(90deg,var(--accent-start),var(--accent-end));color:white;padding:.5rem 1rem;border-radius:999px;font-weight:600;margin-bottom:1rem}
.hero h1{font-size:3.8rem;line-height:1.02;margin-bottom:.6rem;font-weight:800}
.hero h1 .highlight{background:linear-gradient(90deg,var(--accent-start),var(--accent-end));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p.lead{max-width:680px;color:rgba(245,243,236,0.85);font-size:1.05rem}
.hero-ctas{display:flex;gap:1rem;margin-top:2rem}
.btn-primary{background:linear-gradient(90deg,var(--accent-start),var(--accent-end));color:#071014;padding:.9rem 1.2rem;border-radius:12px;border:none;box-shadow:0 10px 30px rgba(212,175,55,0.12);font-weight:700}
.btn-ghost{background:transparent;color:var(--muted);padding:.9rem 1.2rem;border-radius:12px;border:1px solid rgba(255,255,255,0.04)}

/* Glass cards base */
.card-glass{background:var(--glass);border:1px solid var(--glass-border);backdrop-filter:blur(8px);padding:1.25rem;border-radius:12px;color:var(--muted)}

/* Projects grid */
.projects-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.25rem}
.project-card{position:relative;overflow:hidden;border-radius:14px;border:1px solid var(--glass-strong);background:linear-gradient(180deg,rgba(255,255,255,0.02),rgba(255,255,255,0.01));padding:1rem}
.project-image{height:180px;border-radius:10px;overflow:hidden;margin-bottom:.85rem}
.project-card:hover{transform:translateY(-10px) scale(1.01);box-shadow:0 40px 80px rgba(3,6,23,0.7);border-color:rgba(212,175,55,0.95)}
.project-header{color:#fff;font-weight:700}
.project-tech .tech-tag{background:rgba(255,255,255,0.03);color:var(--muted);padding:.35rem .6rem;border-radius:8px}

/* Skills bars */
.skills-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem}
.skill{display:flex;gap:.85rem;align-items:center}
.skill .label{min-width:130px;color:rgba(230,238,252,0.9);font-weight:600}
.bar-outer{flex:1;background:rgba(255,255,255,0.03);height:10px;border-radius:999px;overflow:hidden}
.skill-bar{height:100%;width:0;background:linear-gradient(90deg,var(--accent-start),var(--accent-end));transition:width 1.4s cubic-bezier(.2,.9,.2,1)}

/* Footer */
.footer{background:linear-gradient(90deg,#071024,#0b1330);padding:3rem 0;color:rgba(230,238,252,0.8)}

/* Helpers */
@media (max-width:900px){.hero h1{font-size:2rem}.hero-ctas{flex-direction:column}}
