* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --bg-1: #06101A;
    --bg-2: #0B1D33;
    --surface: rgba(10, 18, 34, 0.88);
    --surface-soft: rgba(18, 31, 55, 0.85);
    --accent: #D4AF37;
    --accent-dark: #B78A24;
    --accent-soft: #E3C26B;
    --text: #F5F2E8;
    --text-muted: rgba(245, 242, 232, 0.78);
    --border: rgba(212, 175, 55, 0.16);
    --shadow: 0 24px 70px rgba(0, 0, 0, 0.25);
    --glass: rgba(255, 255, 255, 0.06);
    --glass-strong: rgba(255, 255, 255, 0.10);
    --success: #16a34a;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: var(--text);
    line-height: 1.7;
    overflow-x: hidden;
    background: radial-gradient(900px 400px at 15% 15%, rgba(212,175,55,0.09), transparent 18%),
                radial-gradient(900px 380px at 85% 80%, rgba(212,175,55,0.06), transparent 18%),
                linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 100%);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Glassmorphism card base */
.glass-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    box-shadow: 0 8px 30px rgba(3,6,23,0.6);
    border-radius: 12px;
}

/* Navigation */
.navbar {
    background: rgba(5, 12, 24, 0.92);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(212, 175, 55, 0.06);
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 20px;
}

.logo {
    font-size: 1.7rem;
    font-weight: 800;
    color: var(--accent);
    font-family: 'Playfair Display', serif;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
}

/* Headings use premium display font and brighter color */
h1, h2, h3 {
    font-family: 'Playfair Display', serif;
    color: var(--text);
    letter-spacing: 0.06em;
}

h2 {
    text-transform: uppercase;
    letter-spacing: 0.18em;
}

/* Make general paragraph and muted text more readable on dark surfaces */
.about-text p,
.experience-card,
.project-card p,
.skill-item li,
.education-card p,
.cert-card li,
.contact-item a,
.contact-item p {
    color: var(--text-muted);
}

/* Brighter link colors for contrast */
.nav-links a,
.project-link,
.social-link,
.btn-primary,
.btn {
    color: var(--accent);
}

.btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 2rem;
}

.nav-links a {
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    transition: color 0.3s ease, transform 0.3s ease;

    }

    .nav-links a:hover {
        color: var(--accent);
        transform: translateY(-2px);
    }

    .nav-links a.active {
        color: var(--text);
/* Hero Section */
.hero {
    background: linear-gradient(135deg, rgba(212,175,55,0.16), rgba(255,255,255,0.04)),
                linear-gradient(180deg, rgba(6, 12, 28, 0.9), rgba(4, 11, 29, 0.84));
    color: var(--text);
    padding: 8rem 0;
    text-align: center;
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
}

.hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 20% 20%, rgba(212,175,55,0.14), transparent 18%),
                radial-gradient(circle at 80% 85%, rgba(212,175,55,0.08), transparent 18%);
    pointer-events: none;
}

.hero-content {
    position: relative;
    z-index: 1;
}

.hero-content h1 {
    font-size: clamp(3rem, 5vw, 4.4rem);
    margin-bottom: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.02;
}

.hero-name {
    display: inline-block;
    background: linear-gradient(90deg, rgba(212,175,55,1), rgba(255,214,117,0.95));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 2px 18px rgba(212,175,55,0.18);
}

.subtitle {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    color: var(--accent-soft);
    letter-spacing: 0.04em;
}

.tagline {
    font-size: 1rem;
    margin-bottom: 2rem;
    color: var(--text-muted);
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
}

/* Buttons */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    border: 2px solid transparent;
}

.btn-primary {
    background: linear-gradient(135deg, var(--accent), var(--accent-dark));
    color: #08101a;
    box-shadow: 0 16px 35px rgba(212,175,55,0.22);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 45px rgba(212,175,55,0.28);
}

.btn-secondary {
    background: transparent;
    color: var(--accent);
    border: 2px solid var(--accent);
}

.btn-secondary:hover {
    background: rgba(212,175,55,0.12);
    color: var(--text);
    transform: translateY(-2px);
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

/* Sections */
section {
    padding: 4rem 0;
}

section h2 {
    font-size: 2.6rem;
    margin-bottom: 0.8rem;
    text-align: center;
    color: var(--text);
}

section h2::after {
    content: '';
    display: block;
    width: 90px;
    height: 3px;
    margin: 1.2rem auto 0;
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(212,175,55,0.95), rgba(212,175,55,0.22));
}

.section-desc {
    text-align: center;
    color: var(--text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
    max-width: 760px;
    margin-left: auto;
    margin-right: auto;
}

/* About Section */
.about {
    background: rgba(12, 19, 38, 0.92);
    border-top: 1px solid rgba(212,175,55,0.08);
    border-bottom: 1px solid rgba(212,175,55,0.08);
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
}

.about-image {
    display: flex;
    justify-content: center;
    align-items: center;
}

.image-placeholder {
    width: 250px;
    height: 250px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(212,175,55,0.18), rgba(31, 45, 72, 0.96));
    box-shadow: 0 22px 70px rgba(212,175,55,0.18);
    position: relative;
    overflow: hidden;
}

.image-placeholder svg {
    width: 100%;
    height: 100%;
    color: var(--text);
}

.image-placeholder img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05);
}

.profile-img {
    border: 5px solid white;
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% {
        transform: translateY(0px);
    }
    50% {
        transform: translateY(-20px);
    }
}

.about-text p {
    margin-bottom: 1rem;
    color: var(--text-muted);
    line-height: 1.8;
}

/* Experience Section */
.experience {
    background: rgba(8, 14, 28, 0.92);
}
.experience-card {
    padding: 2rem;
    border-left: 5px solid rgba(212,175,55,0.9);
    color: var(--text-muted);
    transition: all 0.3s ease;
    background: rgba(12, 18, 34, 0.95);
    border-radius: 1rem;
    box-shadow: var(--shadow);
}

.experience-card:hover {
    transform: translateY(-6px);
}

.experience-header {
    margin-bottom: 1.5rem;
    border-bottom: 2px solid rgba(212,175,55,0.22);
    padding-bottom: 1rem;
}

.experience-header h3 {
    font-size: 1.5rem;
    color: var(--accent);
    margin-bottom: 0.25rem;
}

.company {
    font-weight: 600;
    color: var(--text);
    margin: 0.25rem 0;
}

.duration {
    color: var(--text-muted);
    font-size: 0.9rem;
}

.experience-list {
    list-style: none;
}

.experience-list li {
    padding: 0.75rem 0;
    padding-left: 1.5rem;
    position: relative;
    color: var(--text-muted);
}

.experience-list li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--primary);
    font-weight: bold;
}

/* Project Images */
.project-image {
    width: 100%;
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(212,175,55,0.12), rgba(31, 44, 69, 0.94));
    border-radius: 1rem;
    margin-bottom: 1rem;
    overflow: hidden;
    position: relative;
}

.project-image svg {
    width: 100%;
    height: 100%;
    animation: slideImage 3s ease-in-out infinite;
}

.project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    animation: slideImage 3s ease-in-out infinite;
}

@keyframes slideImage {
    0%, 100% {
        transform: scale(1);
    }
    50% {
        transform: scale(1.05);
    }
}

.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.project-card {
    position: relative;
    padding: 1.5rem;
    transition: transform 0.35s cubic-bezier(.2,.9,.2,1), box-shadow 0.35s, background 0.35s, border-color 0.35s;
    border-radius: 18px;
    border: 1px solid rgba(212,175,55,0.16);
    background: rgba(15, 24, 42, 0.95);
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
}

.project-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 35px 95px rgba(0, 0, 0, 0.42);
    border-color: rgba(212,175,55,0.7);
    background: linear-gradient(180deg, rgba(212,175,55,0.08), rgba(15, 24, 42, 0.96));
}

.project-image {
    border-radius: 16px;
    overflow: hidden;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, rgba(212,175,55,0.08), rgba(255,255,255,0.04));
}

.project-image img { display:block; width:100%; height:180px; object-fit:cover }

/* Project card overlay accent */
.project-card::after {
    content: '';
    position: absolute;
    pointer-events: none;
}

.project-header {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 1rem;
}

.project-card p {
    color: var(--text-muted);
    margin-bottom: 1rem;
}

.project-tech {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
}

.tech-tag {
    background: rgba(212,175,55,0.12);
    color: var(--accent);
    padding: 0.3rem 0.9rem;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
}

.project-link {
    color: var(--accent-soft);
    text-decoration: none;
    font-weight: 700;
    transition: color 0.25s ease, transform 0.2s ease;
}

.project-link:hover {
    color: var(--accent);
    transform: translateX(4px);
}

/* Skill Icons */
.skill-icon {
    width: 90px;
    height: 90px;
    margin: 0 auto 1rem;
    background: linear-gradient(135deg, rgba(212,175,55,0.95), rgba(212,175,55,0.55));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 18px 35px rgba(212,175,55,0.2);
    transition: transform 0.3s ease;
}

.skill-icon:hover {
    transform: scale(1.08);
}

/* Skill bars */
.skill-list {
    margin-top: 0.8rem;
}

.skill {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.9rem;
}

.skill .label {
    min-width: 140px;
    color: var(--text);
    font-weight: 600;
}

.bar-outer {
    flex: 1;
    background: rgba(212,175,55,0.12);
    border-radius: 999px;
    height: 14px;
    overflow: hidden;
}

.skill-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, rgba(212,175,55,0.95), rgba(212,175,55,0.55));
    border-radius: 999px;
    transition: width 1.4s cubic-bezier(.2,.9,.2,1);
}

/* Small responsive tweak */
@media (max-width: 768px) {
    .skill .label { min-width: 110px; font-size: 0.95rem }
}

.skill-icon svg {
    width: 50px;
    height: 50px;
    color: white;
    animation: rotateIcon 6s linear infinite;
}

@keyframes rotateIcon {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}



.skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.skill-item {
        background: rgba(12, 17, 32, 0.94);
        padding: 2rem;
        border-radius: 1rem;
        border-left: 4px solid rgba(212,175,55,0.9);
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.16);
        transition: all 0.3s ease;
    }

    .skill-item:hover {
        transform: translateY(-6px);
        box-shadow: 0 26px 55px rgba(0, 0, 0, 0.22);
    }

    .skill-item h3 {
        color: var(--accent);
        margin-bottom: 1rem;
    }

    .skill-item ul {
        list-style: none;
    }

    .skill-item li {
        padding: 0.5rem 0;
        color: var(--text-muted);
    }

    /* Projects Section */
    .projects {
        background: rgba(10, 18, 32, 0.92);
        border-top: 1px solid rgba(212,175,55,0.08);
        border-bottom: 1px solid rgba(212,175,55,0.08);
    }

    /* Education Section */
    .education {
        background: rgba(8, 14, 28, 0.94);
        border-top: 1px solid rgba(212,175,55,0.08);
        border-bottom: 1px solid rgba(212,175,55,0.08);
    }

.education-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.education-card {
        background: rgba(10, 18, 32, 0.96);
        padding: 2rem;
        border-radius: 1rem;
        border-left: 4px solid rgba(212,175,55,0.92);
        text-align: center;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.16);
        transition: all 0.3s ease;
    }

    .education-card:hover {
        transform: translateY(-6px);
    }

    .education-card h3 {
        color: var(--accent);
        margin-bottom: 0.5rem;
    }

    .education-detail {
        color: var(--text-muted);
        margin-bottom: 0.5rem;
    }

    .education-year {
        font-weight: 600;
        color: var(--text);
    }

    .education-detail-small {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 0.25rem;
    }

    .education-project {
        font-size: 0.9rem;
        color: var(--accent-soft);
        font-weight: 500;
        margin-top: 0.5rem;
    }

    /* Certifications & Languages Section */
    .certifications {
        background: rgba(12, 18, 34, 0.94);
        padding: 4rem 0;
        border-top: 1px solid rgba(212,175,55,0.08);
        border-bottom: 1px solid rgba(212,175,55,0.08);
    }

    .cert-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .cert-card {
        background: rgba(15, 24, 42, 0.98);
        padding: 2rem;
        border-radius: 1rem;
        border-left: 4px solid rgba(22,163,74,0.9);
        box-shadow: 0 18px 40px rgba(0, 0, 0, 0.16);
    }

    .cert-card h3 {
        color: var(--accent);
        margin-bottom: 1.5rem;
        font-size: 1.1rem;
    }

    .cert-card ul {
        list-style: none;
        padding: 0;
    }

    .cert-card li {
        padding: 0.5rem 0;
        color: var(--text-muted);
    padding-left: 1.5rem;
}

.cert-card li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--success);
    font-weight: bold;
}
.contact {
    background: rgba(10, 18, 34, 0.95);
}

.contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
}

.contact-item {
    text-align: center;
    padding: 2rem;
    background: rgba(12, 19, 38, 0.96);
    border-radius: 1rem;
    border: 1px solid rgba(212,175,55,0.12);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
    transition: all 0.3s ease;
}

.contact-item h3 {
    color: var(--accent);
    margin-bottom: 1rem;
}

.contact-item a,
.contact-item p {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.3s ease;
}

.contact-item a:hover {
    color: var(--accent);
}

.social-section {
    text-align: center;
    padding: 2rem;
    background: rgba(12, 18, 34, 0.96);
    border-radius: 1rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.18);
}

.social-section h3 {
    color: var(--text);
    margin-bottom: 1.5rem;
}

.social-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
}

.social-link {
    display: inline-block;
    padding: 0.85rem 1.6rem;
    background: linear-gradient(135deg, rgba(212,175,55,0.98), rgba(183,138,36,0.95));
    color: rgba(8, 16, 26, 0.95);
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.3s ease;
    font-weight: 700;
}

.social-link:hover {
    background: linear-gradient(135deg, rgba(255,215,130,0.95), rgba(212,175,55,0.95));
    transform: translateY(-3px);
    box-shadow: 0 22px 50px rgba(212,175,55,0.24);
}

/* Footer */
.footer {
    background: linear-gradient(135deg, rgba(8, 14, 28, 1), rgba(15, 25, 43, 1));
    color: white;
    text-align: center;
    padding: 2rem 0;
    margin-top: 3rem;
    box-shadow: 0 -10px 30px rgba(0, 0, 0, 0.22);
}

/* Animations */
@keyframes fadeInLeft {
    from {
        opacity: 0;
        transform: translateX(-50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes fadeInRight {
    from {
        opacity: 0;
        transform: translateX(50px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes bounceIn {
    0% {
        opacity: 0;
        transform: scale(0.8);
    }
    50% {
        opacity: 1;
    }
    100% {
        opacity: 1;
        transform: scale(1);
    }
}

.animate-fade-in-left {
    animation: fadeInLeft 0.8s ease-out;
}

.animate-fade-in-right {
    animation: fadeInRight 0.8s ease-out;
}

.animate-slide-up {
    animation: slideUp 0.8s ease-out;
}

.animate-bounce-in {
    animation: bounceIn 0.8s ease-out;
}

/* Responsive */
@media (max-width: 768px) {
    .about-content {
        grid-template-columns: 1fr;
    }

    .image-placeholder {
        width: 200px;
        height: 200px;
    }

    .hero-content h1 {
        font-size: 2.5rem;
    }

    .nav-links {
        gap: 1rem;
        font-size: 0.9rem;
    }

    .about-content {
        grid-template-columns: 1fr;
    }

    section h2 {
        font-size: 2rem;
    }

    .hero-buttons {
        flex-direction: column;
        width: 100%;
    }

    .hero-buttons .btn {
        width: 100%;
    }

    .social-links {
        flex-direction: column;
    }

    .social-link {
        width: 100%;
    }
}